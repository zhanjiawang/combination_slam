<launch>
    <arg name="program_path" default="$(find plane_localization)" />
    <rosparam file="$(find plane_localization)/config/params_localization.yaml" command="load" />
    <node pkg="plane_localization" type="plane_localization" name="plane_localization" args="-program_path $(arg program_path)" output="screen"/>
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find plane_localization)/rviz/show.rviz"/>
</launch>